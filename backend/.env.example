PORT=3000
APP_ORIGIN=http://localhost:5173
SESSION_COOKIE_NAME=megaerp_session
SESSION_JWT_SECRET=CHANGE_ME_32CHARS_MINIMUM
# Gerar um segredo forte (PowerShell):
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Recomendação: rotacionar o SESSION_JWT_SECRET se suspeitar de vazamento.

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=megaerp

# Billing / Planos
# - Em produção, ative somente depois de ter planos/assinaturas sincronizados.
BILLING_ENFORCE_SUBSCRIPTION=false

# Mercado Pago
# - Nunca commitar tokens/chaves.
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
# URL pública base para webhooks (ex.: https://xxxx.ngrok-free.dev)
WEBHOOK_BASE_URL=
# Mercado Pago
# - Obtenha o access token no painel do Mercado Pago.
# - Recomendado: configurar Webhooks no painel e validar assinatura abaixo.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# Google OAuth
# - Configure no Google Cloud Console (OAuth 2.0 Client ID).
# - Authorized redirect URI deve bater EXATAMENTE com GOOGLE_REDIRECT_URI.
# - Nunca commitar GOOGLE_CLIENT_SECRET.

MEGA_NFE_API_URL=
MEGA_NFE_API_KEY=
MEGA_NFE_DEFAULT_ENV=homolog
# Emissão fiscal (API central do SISFEC)
# - MEGA_NFE_API_URL: URL do serviço fiscal do SISFEC (ex: https://nfe.megaerp.com.br)
# - MEGA_NFE_API_KEY: chave do serviço fiscal (somente servidor)
# Gerar MEGA_NFE_API_KEY (PowerShell):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

MP_WEBHOOK_SIGNATURE_SECRET=
# Gerar segredo para validar assinatura do webhook (PowerShell):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
